<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>

  <!-- Managed bindings + libmujoco.dylib (scripts/build-mujoco-macos.sh); models shared with mujoco_viewer. -->
  <ItemGroup>
    <ProjectReference Include="$(SokolRootPath)ext/mujoco/bindings/csharp/Mujoco.NET.csproj" />
    <None Include="$(SokolRootPath)examples/mujoco_viewer/Assets/mjcf/*.xml" Link="mjcf/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <Target Name="CheckMujocoLib" BeforeTargets="Build" Condition="!Exists('$(SokolRootPath)ext/mujoco/libs/macos/arm64/release/libmujoco.dylib')">
    <Error Text="libmujoco.dylib not found. Run scripts/build-mujoco-macos.sh first." />
  </Target>

</Project>
