<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Native libtorch + LibTorchSharp collected by scripts/build-torchsharp-macos.sh -->
    <TorchSharpLibsDir>$(SokolRootPath)ext/TorchSharp/libs/macos/arm64/release/</TorchSharpLibsDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- SkipNative: the native part is built once by the script, not on every demo build -->
    <ProjectReference Include="$(SokolRootPath)ext/TorchSharp/src/TorchSharp/TorchSharp.csproj" AdditionalProperties="Configuration=Release;SkipNative=true" />
    <None Include="$(TorchSharpLibsDir)*.dylib" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <Target Name="CheckTorchSharpLibs" BeforeTargets="Build" Condition="!Exists('$(TorchSharpLibsDir)libLibTorchSharp.dylib')">
    <Error Text="TorchSharp native libraries not found in $(TorchSharpLibsDir). Run scripts/build-torchsharp-macos.sh first." />
  </Target>

</Project>
