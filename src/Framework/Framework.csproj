  <!-- Sokol bindings (separate DLL, shared by the ALC along with Framework) -->
  <ItemGroup>
    <ProjectReference Include="../sokol/sokol.csproj" />
  </ItemGroup>

  <!-- Frent ECS -->
  <ItemGroup>
    <ProjectReference Include="../../ext/Frent/Frent/Frent.csproj" />
  </ItemGroup>

  <!-- JoltPhysics C# bindings compiled directly into GameEditor.Framework.dll -->
  <ItemGroup>
    <Compile Include="../../ext/JoltPhysics/bindings/csharp/src/**/*.cs">
      <Link>JoltPhysics/%(Filename)%(Extension)</Link>
    </Compile>
    <Compile Include="../../ext/JoltPhysics/bindings/csharp/extras/*.cs">
      <Link>JoltPhysics/%(Filename)%(Extension)</Link>
    </Compile>
  </ItemGroup>

  <!-- Sokol.Render2D sources: the sprite batch the renderer draws 2D with, and the 2D surface and particles a
       game's scripts can use. Compiled as source, as the apps that use Render2D do (it draws with Sokol.GUI's types). -->
  <ItemGroup>
    <Compile Include="../Render2D/**/*.cs" Exclude="../Render2D/obj/**;../Render2D/bin/**">
      <Link>Render2D/%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Compile>
  </ItemGroup>

  <!-- MiniAudio's binding: the mixer a game's sound plays through (Sound/Audio.cs). Its library is a file of
       its own, brought to every game by build/Game.targets. -->
  <ItemGroup>
    <Compile Include="../../ext/miniaudio/bindings/csharp/MiniAudio.cs">
      <Link>MiniAudio/MiniAudio.cs</Link>
    </Compile>
  </ItemGroup>

  <!-- The font a game's UI text is drawn with when it names none (Roboto, Apache License 2.0: UI/Roboto-LICENSE.txt). -->
  <ItemGroup>
    <EmbeddedResource Include="UI/Roboto-Regular.ttf" LogicalName="GameEditor.Framework.UI.Roboto-Regular.ttf" />
  </ItemGroup>

  <!-- Sokol.GUI framework sources (used by GameApplication mobile touch UI host) -->
  <ItemGroup>
    <Compile Include="../GUI/**/*.cs">
      <Link>GUI/%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Compile>
  </ItemGroup>

</Project>
