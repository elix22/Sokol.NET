<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>GameEditor.Framework</AssemblyName>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishAot>true</PublishAot>
    <PublishAotUsingRuntimePack>true</PublishAotUsingRuntimePack>
    <TrimMode>partial</TrimMode>
    <TrimmerRemoveSymbols>false</TrimmerRemoveSymbols>
    <NoWarn>$(NoWarn);IL2026;IL2067;IL2070;IL2072;IL2077</NoWarn>
  </PropertyGroup>

  <!-- GridRenderer stays excluded: depends on project-specific phong shaders -->
  <ItemGroup>
    <Compile Remove="Renderer/GridRenderer.cs" />
  </ItemGroup>

  <!-- blinn_phong compiled shader is auto-included by the SDK glob (lives under this project directory).
       The CompileFrameworkShaders target below regenerates it when blinn_phong.glsl changes. -->

  <!-- Derive sokol-shdc path from the repo root (same logic as Directory.Build.props in examples/) -->
  <PropertyGroup>
    <_FrameworkDir>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)'))</_FrameworkDir>
    <_SokolNetRoot>$([MSBuild]::NormalizeDirectory('$(_FrameworkDir)', '..', '..'))</_SokolNetRoot>
    <IsWindowsHost>$([MSBuild]::IsOSPlatform('Windows'))</IsWindowsHost>
    <IsLinuxHost>$([MSBuild]::IsOSPlatform('Linux'))</IsLinuxHost>
    <IsOSXHost>$([MSBuild]::IsOSPlatform('OSX'))</IsOSXHost>
    <OSArch>$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)</OSArch>
    <_HostOS Condition="'$(IsWindowsHost)'=='true'">windows</_HostOS>
    <_HostOS Condition="'$(IsLinuxHost)'=='true'">linux</_HostOS>
    <_HostOS Condition="'$(IsOSXHost)'=='true'">osx</_HostOS>
    <_SokolShdcPath>$(_SokolNetRoot)tools/bin/$(_HostOS)/$(OSArch)/sokol-shdc</_SokolShdcPath>
    <_SokolShdcPath Condition="'$(IsWindowsHost)'=='true'">$(_SokolShdcPath).exe</_SokolShdcPath>
    <!-- Hand-written .glsl sources live in shaders/; sokol-shdc emits the generated C# into
         shaders/compiled/ so the two are not interleaved in one folder. -->
    <_ShaderDir>$(_FrameworkDir)Renderer/Server/shaders/</_ShaderDir>
    <_ShaderOutDir>$(_FrameworkDir)Renderer/Server/shaders/compiled/</_ShaderOutDir>
    <_BlinnPhongGlsl>$(_ShaderDir)blinn_phong.glsl</_BlinnPhongGlsl>
    <_BlinnPhongOut>$(_ShaderOutDir)blinn_phong_shader.cs</_BlinnPhongOut>
    <_ShadowCasterGlsl>$(_ShaderDir)shadow_caster.glsl</_ShadowCasterGlsl>
    <_ShadowCasterOut>$(_ShaderOutDir)shadow_caster_shader.cs</_ShadowCasterOut>
    <_ShadowCasterSkinnedOut>$(_ShaderOutDir)shadow_caster_skinned_shader.cs</_ShadowCasterSkinnedOut>
    <_ShadowDebugGlsl>$(_ShaderDir)shadow_debug.glsl</_ShadowDebugGlsl>
    <_ShadowDebugOut>$(_ShaderOutDir)shadow_debug_shader.cs</_ShadowDebugOut>
    <!-- PBR shader — one output file per variant (base, skinning, morphing, CSM combinations) -->
    <_PbrGlsl>$(_ShaderDir)pbr.glsl</_PbrGlsl>
    <!-- Tonemap post-process pass -->
    <_TonemapPassGlsl>$(_ShaderDir)tonemap_pass.glsl</_TonemapPassGlsl>
    <_TonemapPassOut>$(_ShaderOutDir)tonemap_pass_shader.cs</_TonemapPassOut>
    <!-- Skybox (environment cubemap background) — @include tonemapping.glsl -->
    <_CubemapGlsl>$(_ShaderDir)cubemap.glsl</_CubemapGlsl>
    <_CubemapOut>$(_ShaderOutDir)cubemap_shader.cs</_CubemapOut>
    <_TonemappingGlsl>$(_ShaderDir)tonemapping.glsl</_TonemappingGlsl>
    <!-- Screen-copy blit (captures opaque scene for transmission/refraction sampling) -->
    <_ScreenCopyGlsl>$(_ShaderDir)screen_copy.glsl</_ScreenCopyGlsl>
    <_ScreenCopyOut>$(_ShaderOutDir)screen_copy_shader.cs</_ScreenCopyOut>
  </PropertyGroup>

  <!-- Ensure the generated-shader output folder exists before any shader-compile target writes to
       it (so a clean checkout / fresh machine doesn't fail when sokol-shdc can't create the file). -->
  <Target Name="EnsureFrameworkShaderOutDir">
    <MakeDir Directories="$(_ShaderOutDir)" />
  </Target>

  <!-- Compile blinn_phong.glsl for ALL supported platforms into a single .cs file.
       Uses all slang targets so the generated file works on Windows/Linux/macOS/iOS/Android/Web
       without needing per-platform conditional compilation. -->
  <Target Name="CompileFrameworkShaders" BeforeTargets="BeforeBuild"
          DependsOnTargets="EnsureFrameworkShaderOutDir"
          Inputs="$(_BlinnPhongGlsl)"
          Outputs="$(_BlinnPhongOut)">
    <Message Text="Compiling Framework shader: blinn_phong.glsl (all platforms)" Importance="high" />
    <Exec Command="&quot;$(_SokolShdcPath)&quot; --input &quot;$(_BlinnPhongGlsl)&quot; --output &quot;$(_BlinnPhongOut)&quot; --slang &quot;glsl430:hlsl5:metal_macos:metal_ios:glsl300es&quot; --reflection -f sokol_csharp" />
  </Target>

  <Target Name="CompileFrameworkShadowCasterShader" BeforeTargets="BeforeBuild"
          DependsOnTargets="EnsureFrameworkShaderOutDir"
          Inputs="$(_ShadowCasterGlsl)"
          Outputs="$(_ShadowCasterOut);$(_ShadowCasterSkinnedOut)">
    <Message Text="Compiling Framework shader: shadow_caster.glsl (static + skinned)" Importance="high" />
    <Exec Command="&quot;$(_SokolShdcPath)&quot; --input &quot;$(_ShadowCasterGlsl)&quot; --output &quot;$(_ShadowCasterOut)&quot; --slang &quot;glsl430:hlsl5:metal_macos:metal_ios:glsl300es&quot; --reflection -f sokol_csharp" />
    <Exec Command="&quot;$(_SokolShdcPath)&quot; --input &quot;$(_ShadowCasterGlsl)&quot; --output &quot;$(_ShadowCasterSkinnedOut)&quot; --defines SKINNING --slang &quot;glsl430:hlsl5:metal_macos:metal_ios:glsl300es&quot; --reflection -f sokol_csharp" />
  </Target>

  <Target Name="CompileFrameworkShadowDebugShader" BeforeTargets="BeforeBuild"
          DependsOnTargets="EnsureFrameworkShaderOutDir"
          Inputs="$(_ShadowDebugGlsl)"
          Outputs="$(_ShadowDebugOut)">
    <Message Text="Compiling Framework shader: shadow_debug.glsl (all platforms)" Importance="high" />
    <Exec Command="&quot;$(_SokolShdcPath)&quot; --input &quot;$(_ShadowDebugGlsl)&quot; --output &quot;$(_ShadowDebugOut)&quot; --slang &quot;glsl430:hlsl5:metal_macos:metal_ios:glsl300es&quot; --reflection -f sokol_csharp" />
  </Target>

  <Target Name="CompileFrameworkTonemapShader" BeforeTargets="BeforeBuild"
          DependsOnTargets="EnsureFrameworkShaderOutDir"
          Inputs="$(_TonemapPassGlsl);$(_ShaderDir)tone_curves.glsl"
          Outputs="$(_TonemapPassOut)">
    <Message Text="Compiling Framework shader: tonemap_pass.glsl (all platforms)" Importance="high" />
    <Exec Command="&quot;$(_SokolShdcPath)&quot; --input &quot;$(_TonemapPassGlsl)&quot; --output &quot;$(_TonemapPassOut)&quot; --module tonemap_pass --slang &quot;glsl430:hlsl5:metal_macos:metal_ios:glsl300es&quot; --reflection -f sokol_csharp" />
  </Target>

  <Target Name="CompileFrameworkCubemapShader" BeforeTargets="BeforeBuild"
          DependsOnTargets="EnsureFrameworkShaderOutDir"
          Inputs="$(_CubemapGlsl);$(_TonemappingGlsl)"
          Outputs="$(_CubemapOut)">
    <Message Text="Compiling Framework shader: cubemap.glsl (all platforms)" Importance="high" />
    <Exec Command="&quot;$(_SokolShdcPath)&quot; --input &quot;$(_CubemapGlsl)&quot; --output &quot;$(_CubemapOut)&quot; --module cubemap --slang &quot;glsl430:hlsl5:metal_macos:metal_ios:glsl300es&quot; --reflection -f sokol_csharp" />
  </Target>

  <Target Name="CompileFrameworkScreenCopyShader" BeforeTargets="BeforeBuild"
          DependsOnTargets="EnsureFrameworkShaderOutDir"
          Inputs="$(_ScreenCopyGlsl)"
          Outputs="$(_ScreenCopyOut)">
    <Message Text="Compiling Framework shader: screen_copy.glsl (all platforms)" Importance="high" />
    <Exec Command="&quot;$(_SokolShdcPath)&quot; --input &quot;$(_ScreenCopyGlsl)&quot; --output &quot;$(_ScreenCopyOut)&quot; --module screen_copy --slang &quot;glsl430:hlsl5:metal_macos:metal_ios:glsl300es&quot; --reflection -f sokol_csharp" />
  </Target>

  <!-- PBR shader variants: one .cs file per define combination.
       All 8 share the same source (pbr.glsl) but each gets its own defines flag.
       Inputs include the primary file AND all @include files so any change triggers a rebuild. -->
  <Target Name="CompileFrameworkPbrShaders" BeforeTargets="BeforeBuild"
          DependsOnTargets="EnsureFrameworkShaderOutDir"
          Inputs="$(_PbrGlsl);
                  $(_ShaderDir)fs_constants.glsl;
                  $(_ShaderDir)pbr_vs_uniforms.glsl;
                  $(_ShaderDir)pbr_fs_uniforms.glsl;
                  $(_ShaderDir)fs_lighting.glsl;
                  $(_ShaderDir)tone_curves.glsl;
                  $(_ShaderDir)brdf.glsl;
                  $(_ShaderDir)ibl.glsl;
                  $(_ShaderDir)animation.glsl"
          Outputs="$(_ShaderOutDir)pbr_shader.cs;
                   $(_ShaderOutDir)pbr_skinning_shader.cs;
                   $(_ShaderOutDir)pbr_morphing_shader.cs;
                   $(_ShaderOutDir)pbr_skinning_morphing_shader.cs;
                   $(_ShaderOutDir)pbr_csm1_shader.cs;
                   $(_ShaderOutDir)pbr_csm4_shader.cs;
                   $(_ShaderOutDir)pbr_skinning_csm4_shader.cs;
                   $(_ShaderOutDir)pbr_skinning_csm1_shader.cs;
                   $(_ShaderOutDir)pbr_skinning_morphing_csm1_shader.cs;
                   $(_ShaderOutDir)pbr_skinning_morphing_csm4_shader.cs;
                   $(_ShaderOutDir)pbr_transmission_shader.cs">
    <Message Text="Compiling Framework PBR shader variants (11 total)" Importance="high" />
    <Exec Command="&quot;$(_SokolShdcPath)&quot; --input &quot;$(_PbrGlsl)&quot; --output &quot;$(_ShaderOutDir)pbr_shader.cs&quot; --module pbr --slang &quot;glsl430:hlsl5:metal_macos:metal_ios:glsl300es&quot; --reflection -f sokol_csharp" />
    <Exec Command="&quot;$(_SokolShdcPath)&quot; --input &quot;$(_PbrGlsl)&quot; --output &quot;$(_ShaderOutDir)pbr_skinning_shader.cs&quot; --module pbr_skinning --defines SKINNING --slang &quot;glsl430:hlsl5:metal_macos:metal_ios:glsl300es&quot; --reflection -f sokol_csharp" />
    <Exec Command="&quot;$(_SokolShdcPath)&quot; --input &quot;$(_PbrGlsl)&quot; --output &quot;$(_ShaderOutDir)pbr_morphing_shader.cs&quot; --module pbr_morphing --defines MORPHING --slang &quot;glsl430:hlsl5:metal_macos:metal_ios:glsl300es&quot; --reflection -f sokol_csharp" />
    <Exec Command="&quot;$(_SokolShdcPath)&quot; --input &quot;$(_PbrGlsl)&quot; --output &quot;$(_ShaderOutDir)pbr_skinning_morphing_shader.cs&quot; --module pbr_skinning_morphing --defines SKINNING:MORPHING --slang &quot;glsl430:hlsl5:metal_macos:metal_ios:glsl300es&quot; --reflection -f sokol_csharp" />
    <Exec Command="&quot;$(_SokolShdcPath)&quot; --input &quot;$(_PbrGlsl)&quot; --output &quot;$(_ShaderOutDir)pbr_csm1_shader.cs&quot; --module pbr_csm1 --defines CSM1 --slang &quot;glsl430:hlsl5:metal_macos:metal_ios:glsl300es&quot; --reflection -f sokol_csharp" />
    <Exec Command="&quot;$(_SokolShdcPath)&quot; --input &quot;$(_PbrGlsl)&quot; --output &quot;$(_ShaderOutDir)pbr_csm4_shader.cs&quot; --module pbr_csm4 --defines CSM4 --slang &quot;glsl430:hlsl5:metal_macos:metal_ios:glsl300es&quot; --reflection -f sokol_csharp" />
    <Exec Command="&quot;$(_SokolShdcPath)&quot; --input &quot;$(_PbrGlsl)&quot; --output &quot;$(_ShaderOutDir)pbr_skinning_csm4_shader.cs&quot; --module pbr_skinning_csm4 --defines SKINNING:CSM4 --slang &quot;glsl430:hlsl5:metal_macos:metal_ios:glsl300es&quot; --reflection -f sokol_csharp" />
    <Exec Command="&quot;$(_SokolShdcPath)&quot; --input &quot;$(_PbrGlsl)&quot; --output &quot;$(_ShaderOutDir)pbr_skinning_csm1_shader.cs&quot; --module pbr_skinning_csm1 --defines SKINNING:CSM1 --slang &quot;glsl430:hlsl5:metal_macos:metal_ios:glsl300es&quot; --reflection -f sokol_csharp" />
    <Exec Command="&quot;$(_SokolShdcPath)&quot; --input &quot;$(_PbrGlsl)&quot; --output &quot;$(_ShaderOutDir)pbr_skinning_morphing_csm1_shader.cs&quot; --module pbr_skinning_morphing_csm1 --defines SKINNING:MORPHING:CSM1 --slang &quot;glsl430:hlsl5:metal_macos:metal_ios:glsl300es&quot; --reflection -f sokol_csharp" />
    <Exec Command="&quot;$(_SokolShdcPath)&quot; --input &quot;$(_PbrGlsl)&quot; --output &quot;$(_ShaderOutDir)pbr_skinning_morphing_csm4_shader.cs&quot; --module pbr_skinning_morphing_csm4 --defines SKINNING:MORPHING:CSM4 --slang &quot;glsl430:hlsl5:metal_macos:metal_ios:glsl300es&quot; --reflection -f sokol_csharp" />
    <Exec Command="&quot;$(_SokolShdcPath)&quot; --input &quot;$(_PbrGlsl)&quot; --output &quot;$(_ShaderOutDir)pbr_transmission_shader.cs&quot; --module pbr_transmission --defines TRANSMISSION --slang &quot;glsl430:hlsl5:metal_macos:metal_ios:glsl300es&quot; --reflection -f sokol_csharp" />
  </Target>

  <!-- CLUSTERED variants (Forward+, G8.2: examples/GameEditor/docs/CLUSTERED_LIGHTING_DESIGN.md): each PBR family's
       shader reading its lights from the view's cluster texture. ShaderVariantCache makes one only when a perspective
       view draws in Forward+ on a GPU that is not LOW_TIER. -->
  <Target Name="CompileFrameworkClusteredShaders" BeforeTargets="BeforeBuild"
          DependsOnTargets="EnsureFrameworkShaderOutDir"
          Inputs="$(_PbrGlsl);
                  $(_ShaderDir)fs_constants.glsl;
                  $(_ShaderDir)pbr_vs_uniforms.glsl;
                  $(_ShaderDir)pbr_fs_uniforms.glsl;
                  $(_ShaderDir)fs_lighting.glsl;
                  $(_ShaderDir)tone_curves.glsl;
                  $(_ShaderDir)brdf.glsl;
                  $(_ShaderDir)ibl.glsl;
                  $(_ShaderDir)animation.glsl"
          Outputs="$(_ShaderOutDir)pbr_clustered_shader.cs;
                   $(_ShaderOutDir)pbr_csm1_clustered_shader.cs;
                   $(_ShaderOutDir)pbr_csm4_clustered_shader.cs;
                   $(_ShaderOutDir)pbr_skinning_clustered_shader.cs;
                   $(_ShaderOutDir)pbr_skinning_csm1_clustered_shader.cs;
                   $(_ShaderOutDir)pbr_skinning_csm4_clustered_shader.cs;
                   $(_ShaderOutDir)pbr_skinning_morphing_clustered_shader.cs;
                   $(_ShaderOutDir)pbr_skinning_morphing_csm1_clustered_shader.cs;
                   $(_ShaderOutDir)pbr_skinning_morphing_csm4_clustered_shader.cs;
                   $(_ShaderOutDir)pbr_transmission_clustered_shader.cs">
    <Message Text="Compiling Framework CLUSTERED (Forward+) shader variants (10)" Importance="high" />
    <Exec Command="&quot;$(_SokolShdcPath)&quot; --input &quot;$(_PbrGlsl)&quot; --output &quot;$(_ShaderOutDir)pbr_clustered_shader.cs&quot; --module pbr_clustered --defines CLUSTERED --slang &quot;glsl430:hlsl5:metal_macos:metal_ios:glsl300es&quot; --reflection -f sokol_csharp" />
    <Exec Command="&quot;$(_SokolShdcPath)&quot; --input &quot;$(_PbrGlsl)&quot; --output &quot;$(_ShaderOutDir)pbr_csm1_clustered_shader.cs&quot; --module pbr_csm1_clustered --defines CLUSTERED:CSM1 --slang &quot;glsl430:hlsl5:metal_macos:metal_ios:glsl300es&quot; --reflection -f sokol_csharp" />
    <Exec Command="&quot;$(_SokolShdcPath)&quot; --input &quot;$(_PbrGlsl)&quot; --output &quot;$(_ShaderOutDir)pbr_csm4_clustered_shader.cs&quot; --module pbr_csm4_clustered --defines CLUSTERED:CSM4 --slang &quot;glsl430:hlsl5:metal_macos:metal_ios:glsl300es&quot; --reflection -f sokol_csharp" />
    <Exec Command="&quot;$(_SokolShdcPath)&quot; --input &quot;$(_PbrGlsl)&quot; --output &quot;$(_ShaderOutDir)pbr_skinning_clustered_shader.cs&quot; --module pbr_skinning_clustered --defines CLUSTERED:SKINNING --slang &quot;glsl430:hlsl5:metal_macos:metal_ios:glsl300es&quot; --reflection -f sokol_csharp" />
    <Exec Command="&quot;$(_SokolShdcPath)&quot; --input &quot;$(_PbrGlsl)&quot; --output &quot;$(_ShaderOutDir)pbr_skinning_csm1_clustered_shader.cs&quot; --module pbr_skinning_csm1_clustered --defines CLUSTERED:SKINNING:CSM1 --slang &quot;glsl430:hlsl5:metal_macos:metal_ios:glsl300es&quot; --reflection -f sokol_csharp" />
    <Exec Command="&quot;$(_SokolShdcPath)&quot; --input &quot;$(_PbrGlsl)&quot; --output &quot;$(_ShaderOutDir)pbr_skinning_csm4_clustered_shader.cs&quot; --module pbr_skinning_csm4_clustered --defines CLUSTERED:SKINNING:CSM4 --slang &quot;glsl430:hlsl5:metal_macos:metal_ios:glsl300es&quot; --reflection -f sokol_csharp" />
    <Exec Command="&quot;$(_SokolShdcPath)&quot; --input &quot;$(_PbrGlsl)&quot; --output &quot;$(_ShaderOutDir)pbr_skinning_morphing_clustered_shader.cs&quot; --module pbr_skinning_morphing_clustered --defines CLUSTERED:SKINNING:MORPHING --slang &quot;glsl430:hlsl5:metal_macos:metal_ios:glsl300es&quot; --reflection -f sokol_csharp" />
    <Exec Command="&quot;$(_SokolShdcPath)&quot; --input &quot;$(_PbrGlsl)&quot; --output &quot;$(_ShaderOutDir)pbr_skinning_morphing_csm1_clustered_shader.cs&quot; --module pbr_skinning_morphing_csm1_clustered --defines CLUSTERED:SKINNING:MORPHING:CSM1 --slang &quot;glsl430:hlsl5:metal_macos:metal_ios:glsl300es&quot; --reflection -f sokol_csharp" />
    <Exec Command="&quot;$(_SokolShdcPath)&quot; --input &quot;$(_PbrGlsl)&quot; --output &quot;$(_ShaderOutDir)pbr_skinning_morphing_csm4_clustered_shader.cs&quot; --module pbr_skinning_morphing_csm4_clustered --defines CLUSTERED:SKINNING:MORPHING:CSM4 --slang &quot;glsl430:hlsl5:metal_macos:metal_ios:glsl300es&quot; --reflection -f sokol_csharp" />
    <Exec Command="&quot;$(_SokolShdcPath)&quot; --input &quot;$(_PbrGlsl)&quot; --output &quot;$(_ShaderOutDir)pbr_transmission_clustered_shader.cs&quot; --module pbr_transmission_clustered --defines CLUSTERED:TRANSMISSION --slang &quot;glsl430:hlsl5:metal_macos:metal_ios:glsl300es&quot; --reflection -f sokol_csharp" />
  </Target>

  <!-- LOW_TIER variants (GLSL ES 3.0 only: WebGL 2 and Android GLES 3): the lit shaders with 16 lights,
       4 spot-shadow matrices, 1 point-shadow light and skinning through the joint texture, for a GPU whose
       uniform limits refuse the full ones (PowerVR GE8320: 1024 fragment components). ShaderVariantCache
       makes one only when the full shader of its family failed to compile; other GPUs never load them. -->
  <Target Name="CompileFrameworkLowTierShaders" BeforeTargets="BeforeBuild"
          DependsOnTargets="EnsureFrameworkShaderOutDir"
          Inputs="$(_PbrGlsl);
                  $(_BlinnPhongGlsl);
                  $(_ShadowCasterGlsl);
                  $(_ShaderDir)fs_constants.glsl;
                  $(_ShaderDir)pbr_vs_uniforms.glsl;
                  $(_ShaderDir)pbr_fs_uniforms.glsl;
                  $(_ShaderDir)fs_lighting.glsl;
                  $(_ShaderDir)tone_curves.glsl;
                  $(_ShaderDir)brdf.glsl;
                  $(_ShaderDir)ibl.glsl;
                  $(_ShaderDir)animation.glsl"
          Outputs="$(_ShaderOutDir)pbr_low_shader.cs;
                   $(_ShaderOutDir)pbr_csm1_low_shader.cs;
                   $(_ShaderOutDir)pbr_csm4_low_shader.cs;
                   $(_ShaderOutDir)pbr_skinning_low_shader.cs;
                   $(_ShaderOutDir)pbr_skinning_csm1_low_shader.cs;
                   $(_ShaderOutDir)pbr_skinning_csm4_low_shader.cs;
                   $(_ShaderOutDir)pbr_skinning_morphing_low_shader.cs;
                   $(_ShaderOutDir)pbr_skinning_morphing_csm1_low_shader.cs;
                   $(_ShaderOutDir)pbr_skinning_morphing_csm4_low_shader.cs;
                   $(_ShaderOutDir)pbr_transmission_low_shader.cs;
                   $(_ShaderOutDir)blinn_phong_low_shader.cs;
                   $(_ShaderOutDir)shadow_caster_skinned_low_shader.cs">
    <Message Text="Compiling Framework LOW_TIER shader variants (12, glsl300es)" Importance="high" />
    <Exec Command="&quot;$(_SokolShdcPath)&quot; --input &quot;$(_PbrGlsl)&quot; --output &quot;$(_ShaderOutDir)pbr_low_shader.cs&quot; --module pbr_low --defines LOW_TIER --slang glsl300es --reflection -f sokol_csharp" />
    <Exec Command="&quot;$(_SokolShdcPath)&quot; --input &quot;$(_PbrGlsl)&quot; --output &quot;$(_ShaderOutDir)pbr_csm1_low_shader.cs&quot; --module pbr_csm1_low --defines LOW_TIER:CSM1 --slang glsl300es --reflection -f sokol_csharp" />
    <Exec Command="&quot;$(_SokolShdcPath)&quot; --input &quot;$(_PbrGlsl)&quot; --output &quot;$(_ShaderOutDir)pbr_csm4_low_shader.cs&quot; --module pbr_csm4_low --defines LOW_TIER:CSM4 --slang glsl300es --reflection -f sokol_csharp" />
    <Exec Command="&quot;$(_SokolShdcPath)&quot; --input &quot;$(_PbrGlsl)&quot; --output &quot;$(_ShaderOutDir)pbr_skinning_low_shader.cs&quot; --module pbr_skinning_low --defines LOW_TIER:SKINNING --slang glsl300es --reflection -f sokol_csharp" />
    <Exec Command="&quot;$(_SokolShdcPath)&quot; --input &quot;$(_PbrGlsl)&quot; --output &quot;$(_ShaderOutDir)pbr_skinning_csm1_low_shader.cs&quot; --module pbr_skinning_csm1_low --defines LOW_TIER:SKINNING:CSM1 --slang glsl300es --reflection -f sokol_csharp" />
    <Exec Command="&quot;$(_SokolShdcPath)&quot; --input &quot;$(_PbrGlsl)&quot; --output &quot;$(_ShaderOutDir)pbr_skinning_csm4_low_shader.cs&quot; --module pbr_skinning_csm4_low --defines LOW_TIER:SKINNING:CSM4 --slang glsl300es --reflection -f sokol_csharp" />
    <Exec Command="&quot;$(_SokolShdcPath)&quot; --input &quot;$(_PbrGlsl)&quot; --output &quot;$(_ShaderOutDir)pbr_skinning_morphing_low_shader.cs&quot; --module pbr_skinning_morphing_low --defines LOW_TIER:SKINNING:MORPHING --slang glsl300es --reflection -f sokol_csharp" />
    <Exec Command="&quot;$(_SokolShdcPath)&quot; --input &quot;$(_PbrGlsl)&quot; --output &quot;$(_ShaderOutDir)pbr_skinning_morphing_csm1_low_shader.cs&quot; --module pbr_skinning_morphing_csm1_low --defines LOW_TIER:SKINNING:MORPHING:CSM1 --slang glsl300es --reflection -f sokol_csharp" />
