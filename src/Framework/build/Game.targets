<Project>
  <!--
    What the engine adds to every game project made with it, whenever the project's own build files were
    written. A project imports this file from its Directory.Build.targets (the editor adds the line to a project
    that has none), so that engine parts added later reach it without its files being edited again.
  -->

  <!-- Web: the Framework is compiled into the game as source (see the project's Directory.Build.props), and the
       2D renderer's sources go with it. On the desktop and on phones they are inside GameEditor.Framework.dll. -->
  <ItemGroup Condition="'$(TargetOS)' == 'browser'">
    <Compile Include="$(MSBuildThisFileDirectory)../../Render2D/**/*.cs"
             Exclude="$(MSBuildThisFileDirectory)../../Render2D/obj/**;$(MSBuildThisFileDirectory)../../Render2D/bin/**">
      <Link>Render2D/%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Compile>
  </ItemGroup>

  <!-- Box2D, the 2D physics library. Its binding is inside the engine; the library is a file of its own.
       Desktop: copied beside the app. Web: linked into the page. (Android and iOS: the project's
       Directory.Build.props names the folders, where the app builder reads them.) -->
  <PropertyGroup>
    <Box2DLibs>$(MSBuildThisFileDirectory)../../../ext/box2d/libs</Box2DLibs>
    <Box2DArch>$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)</Box2DArch>
    <Box2DLib Condition="$([MSBuild]::IsOSPlatform('OSX'))">$(Box2DLibs)/macos/$(Box2DArch)/release/libbox2d.dylib</Box2DLib>
    <Box2DLib Condition="$([MSBuild]::IsOSPlatform('Linux'))">$(Box2DLibs)/linux/$(Box2DArch)/release/libbox2d.so</Box2DLib>
    <Box2DLib Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(Box2DLibs)/windows/$(Box2DArch)/release/box2d.dll</Box2DLib>
  </PropertyGroup>
  <Target Name="CopyBox2D" AfterTargets="AfterBuild" Condition="'$(TargetOS)' != 'browser' and '$(Box2DLib)' != '' and Exists('$(Box2DLib)')">
    <Copy SourceFiles="$(Box2DLib)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyBox2DPublish" AfterTargets="Publish" Condition="'$(TargetOS)' != 'browser' and '$(Box2DLib)' != '' and Exists('$(Box2DLib)')">
    <Copy SourceFiles="$(Box2DLib)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>
  <ItemGroup Condition="'$(TargetOS)' == 'browser' and Exists('$(Box2DLibs)/emscripten/x86/release/box2d.a')">
    <NativeFileReference Include="$(Box2DLibs)/emscripten/x86/release/box2d.a">
      <Link>libs\box2d.a</Link>
    </NativeFileReference>
  </ItemGroup>

  <!-- MiniAudio, the mixer a game's sound plays through. As Box2D: its binding is inside the engine (on the web
       it is compiled into the game with the rest of the engine's sources), the library is a file of its own. -->
  <PropertyGroup>
    <MiniAudioLibs>$(MSBuildThisFileDirectory)../../../ext/miniaudio/libs</MiniAudioLibs>
    <MiniAudioMac Condition="'$(Box2DArch)' == 'Arm64'">arm64</MiniAudioMac>
    <MiniAudioMac Condition="'$(Box2DArch)' != 'Arm64'">x86_64</MiniAudioMac>
    <MiniAudioLib Condition="$([MSBuild]::IsOSPlatform('OSX'))">$(MiniAudioLibs)/macos/$(MiniAudioMac)/release/libminiaudio.dylib</MiniAudioLib>
    <MiniAudioLib Condition="$([MSBuild]::IsOSPlatform('Linux'))">$(MiniAudioLibs)/linux/X64/release/libminiaudio.so</MiniAudioLib>
    <MiniAudioLib Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(MiniAudioLibs)/windows/x64/release/miniaudio.dll</MiniAudioLib>
  </PropertyGroup>
  <Target Name="CopyMiniAudio" AfterTargets="AfterBuild" Condition="'$(TargetOS)' != 'browser' and '$(MiniAudioLib)' != '' and Exists('$(MiniAudioLib)')">
    <Copy SourceFiles="$(MiniAudioLib)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyMiniAudioPublish" AfterTargets="Publish" Condition="'$(TargetOS)' != 'browser' and '$(MiniAudioLib)' != '' and Exists('$(MiniAudioLib)')">
    <Copy SourceFiles="$(MiniAudioLib)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>
  <ItemGroup Condition="'$(TargetOS)' == 'browser'">
    <Compile Include="$(MSBuildThisFileDirectory)../../../ext/miniaudio/bindings/csharp/MiniAudio.cs">
      <Link>MiniAudio/MiniAudio.cs</Link>
    </Compile>
  </ItemGroup>
  <ItemGroup Condition="'$(TargetOS)' == 'browser' and Exists('$(MiniAudioLibs)/emscripten/x86/release/miniaudio.a')">
    <NativeFileReference Include="$(MiniAudioLibs)/emscripten/x86/release/miniaudio.a">
      <Link>libs\miniaudio.a</Link>
    </NativeFileReference>
  </ItemGroup>

  <!-- Saved data on the web: the app's own folder is kept in the browser. The file is given to the linker, which
       needs the IndexedDB file system for it. -->
  <PropertyGroup Condition="'$(TargetOS)' == 'browser'">
    <EmccExtraLDFlags>$(EmccExtraLDFlags) -lidbfs.js --pre-js "$(MSBuildThisFileDirectory)savedata.pre.js"</EmccExtraLDFlags>
  </PropertyGroup>
</Project>
