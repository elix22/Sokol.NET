<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Headless tests for the scene plugin hooks in src/Framework/Scene: SceneSerializer component
    extensions + preservation of unknown component blocks, the scene "physics" backend key, and the
    SceneManager ISceneSimulator dispatch. References Framework.csproj (the serializer touches every
    built-in component) but never calls into Sokol or Jolt natives.

    Run:  dotnet test tests/Scene.Tests
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <PublishAot>false</PublishAot>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.13.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Framework/Framework.csproj" />
  </ItemGroup>

  <!-- The 2D physics tests run the real Box2D: its library for this machine goes beside the tests. (The 3D
       tests need no native library: they play with a stand-in backend.) -->
  <!-- The sound tests run the real mixer, with no device: its library goes beside the tests too. -->
  <Target Name="CopyMiniAudio" AfterTargets="Build">
    <PropertyGroup>
      <MiniAudioLibs>$(MSBuildThisFileDirectory)../../ext/miniaudio/libs</MiniAudioLibs>
      <MiniAudioArch>$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)</MiniAudioArch>
      <MiniAudioMac Condition="'$(MiniAudioArch)' == 'Arm64'">arm64</MiniAudioMac>
      <MiniAudioMac Condition="'$(MiniAudioArch)' != 'Arm64'">x86_64</MiniAudioMac>
      <MiniAudioLib Condition="$([MSBuild]::IsOSPlatform('OSX'))">$(MiniAudioLibs)/macos/$(MiniAudioMac)/release/libminiaudio.dylib</MiniAudioLib>
      <MiniAudioLib Condition="$([MSBuild]::IsOSPlatform('Linux'))">$(MiniAudioLibs)/linux/X64/release/libminiaudio.so</MiniAudioLib>
      <MiniAudioLib Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(MiniAudioLibs)/windows/x64/release/miniaudio.dll</MiniAudioLib>
    </PropertyGroup>
    <Copy SourceFiles="$(MiniAudioLib)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="'$(MiniAudioLib)' != '' and Exists('$(MiniAudioLib)')" />
  </Target>

  <Target Name="CopyBox2D" AfterTargets="Build">
    <PropertyGroup>
      <Box2DLibs>$(MSBuildThisFileDirectory)../../ext/box2d/libs</Box2DLibs>
      <Box2DArch>$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)</Box2DArch>
      <Box2DLib Condition="$([MSBuild]::IsOSPlatform('OSX'))">$(Box2DLibs)/macos/$(Box2DArch)/release/libbox2d.dylib</Box2DLib>
      <Box2DLib Condition="$([MSBuild]::IsOSPlatform('Linux'))">$(Box2DLibs)/linux/$(Box2DArch)/release/libbox2d.so</Box2DLib>
      <Box2DLib Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(Box2DLibs)/windows/$(Box2DArch)/release/box2d.dll</Box2DLib>
    </PropertyGroup>
    <Copy SourceFiles="$(Box2DLib)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="Exists('$(Box2DLib)')" />
  </Target>

  <!-- As a game project embeds its Embedded folder (EmbeddedFiles reads it). -->
  <ItemGroup>
    <EmbeddedResource Include="Embedded/**/*" LogicalName="Embedded/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
